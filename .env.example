# Copy to .env. Keep real keys out of Git and chat.
MODEL_PROVIDER=groq
GROQ_API_KEY=
MODEL_NAME=qwen/qwen3.8-27b
BUSINESS_API_URL=http://127.0.0.1:8000
# Optional local Functions host: set BUSINESS_API_URL=http://127.0.0.1:7071 in a separate terminal.
# FastEmbed downloads a small local embedding model on first explicit index build.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
